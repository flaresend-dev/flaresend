{
  "name": "@flaresend/client",
  "version": "0.2.0",
  "description": "Flaresend client over HTTP (fetch) or a Cloudflare service binding (RPC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaresend-dev/flaresend.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/flaresend-dev/flaresend/tree/main/packages/client#readme",
  "bugs": "https://github.com/flaresend-dev/flaresend/issues",
  "keywords": ["email", "cloudflare", "workers", "transactional-email", "sdk", "flaresend"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./rpc": {
      "import": { "types": "./dist/rpc.d.ts", "default": "./dist/rpc.js" },
      "require": { "types": "./dist/rpc.d.cts", "default": "./dist/rpc.cjs" }
    },
    "./webhooks": {
      "import": { "types": "./dist/webhooks.d.ts", "default": "./dist/webhooks.js" },
      "require": { "types": "./dist/webhooks.d.cts", "default": "./dist/webhooks.cjs" }
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts src/rpc.ts src/webhooks.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flaresend/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
