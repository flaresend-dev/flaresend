{
  "name": "@flaresend/mailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply flaresend --local",
    "migrate:remote": "wrangler d1 migrations apply flaresend --remote",
    "dev:event": "pnpm --filter @flaresend/cli dev:event"
  },
  "dependencies": {
    "@flaresend/templates": "workspace:*",
    "@flaresend/types": "workspace:*",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.9",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@flaresend/client": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.140.0"
  }
}
