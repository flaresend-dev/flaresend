{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaresend",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Keep prettier (pulled in by @react-email/render, never used) out of the bundle.
  "alias": {
    "prettier/standalone": "./src/stubs/prettier.ts",
    "prettier/plugins/html": "./src/stubs/prettier.ts"
  },
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production",
    "BROADCAST_MAX_RECIPIENTS": "500"
    // PUBLIC_BASE_URL and CF_ACCOUNT_ID are secrets, not vars, so this file holds nothing account-specific.
    // `pnpm bootstrap` sets them; see scripts/setup.md.
  },

  "send_email": [
    { "name": "EMAIL" }
    // Do NOT add allowed_sender_addresses here. Sender restriction is enforced per project in code.
    // For local dev, wrangler.dev.jsonc sets "remote": true so `wrangler dev` sends real mail.
  ],

  "d1_databases": [
    // No database_id: wrangler looks the database up by name in the account you deploy to.
    { "binding": "DB", "database_name": "flaresend", "migrations_dir": "migrations" }
  ],

  "r2_buckets": [
    { "binding": "PAYLOADS", "bucket_name": "flaresend-payloads" }
  ],

  "queues": {
    "producers": [
      { "binding": "SEND_QUEUE", "queue": "flaresend-send" },
      { "binding": "WEBHOOK_QUEUE", "queue": "flaresend-webhooks" }
    ],
    "consumers": [
      {
        "queue": "flaresend-send",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "max_concurrency": 5,
        "dead_letter_queue": "flaresend-dlq"
      },
      {
        "queue": "flaresend-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "flaresend-dlq"
      },
      {
        "queue": "flaresend-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "flaresend-dlq"
      },
      { "queue": "flaresend-dlq", "max_batch_size": 50, "max_retries": 0 }
    ]
  },

  // Global safety valve. Per-project daily limits are enforced in D1. period must be 10 or 60.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],

  // Scheduled sends beyond 12h, broadcasts, daily analytics rollup.
  "triggers": { "crons": ["*/5 * * * *"] }
}
