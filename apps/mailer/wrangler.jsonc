{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaresend",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Keep prettier (pulled in by @react-email/render, never used) out of the bundle.
  "alias": {
    "prettier/standalone": "./src/stubs/prettier.ts",
    "prettier/plugins/html": "./src/stubs/prettier.ts"
  },
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production",
    // 0 means no cap. Set a number to limit how many contacts one broadcast may go to.
    "BROADCAST_MAX_RECIPIENTS": "0",
    // Workers AI writing help in the newsletter editor. Remove the "ai" binding below to turn it off.
    "NEWSLETTER_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "NEWSLETTER_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "NEWSLETTER_AI_HOURLY_LIMIT": "120"
    // PUBLIC_BASE_URL and CF_ACCOUNT_ID are secrets, not vars, so this file holds nothing account-specific.
    // `pnpm bootstrap` sets them; see scripts/setup.md.
  },

  // Workers AI always runs on Cloudflare (also under `wrangler dev`) and is billed to the account.
  "ai": { "binding": "AI" },

  "send_email": [
    { "name": "EMAIL" }
    // Do NOT add allowed_sender_addresses here. Sender restriction is enforced per project in code.
    // For local dev, wrangler.dev.jsonc sets "remote": true so `wrangler dev` sends real mail.
  ],
  "secrets": { "required": ["PUBLIC_BASE_URL", "CF_ACCOUNT_ID", "ADMIN_API_KEY", "TRACKING_SECRET", "CF_API_TOKEN"] },

  "d1_databases": [
    // No database_id: wrangler looks the database up by name in the account you deploy to.
    { "binding": "DB", "database_name": "flaresend", "migrations_dir": "migrations" }
  ],

  "r2_buckets": [
    { "binding": "PAYLOADS", "bucket_name": "flaresend-payloads" }
  ],

  "queues": {
    "producers": [
      { "binding": "NEWSLETTER_QUEUE", "queue": "flaresend-newsletters" },
      { "binding": "SEND_QUEUE", "queue": "flaresend-send" },
      { "binding": "WEBHOOK_QUEUE", "queue": "flaresend-webhooks" }
    ],
    "consumers": [
      { "queue": "flaresend-newsletters", "max_batch_size": 1, "max_retries": 8, "max_concurrency": 2, "dead_letter_queue": "flaresend-dlq" },
      {
        "queue": "flaresend-send",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "max_concurrency": 5,
        "dead_letter_queue": "flaresend-dlq"
      },
      {
        "queue": "flaresend-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "flaresend-dlq"
      },
      {
        "queue": "flaresend-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "flaresend-dlq"
      },
      { "queue": "flaresend-dlq", "max_batch_size": 50, "max_retries": 0 }
    ]
  },

  // Global safety valve. Per-project daily limits are enforced in D1. period must be 10 or 60.
  "ratelimits": [
    { "name": "NEWSLETTER_PUBLIC_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],

  // Scheduled sends beyond 12h, broadcasts, daily analytics rollup.
  "triggers": { "crons": ["*/5 * * * *"] }
}
